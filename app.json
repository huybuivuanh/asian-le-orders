{
  "expo": {
    "name": "asian-le-orders",
    "slug": "asian-le-orders",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "asianleorders",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/favicon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.asianle.asianleorders",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65fb7a63-7a1b-4200-9592-10fd9080665b"
      }
    },
    "owner": "buivuanhhuy"
  }
}
